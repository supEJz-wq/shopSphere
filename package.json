{
  "name": "shopsphere",
  "version": "1.0.0",
  "private": true,
  "description": "ShopSphere V1 - Full Stack E-Commerce (root convenience scripts)",
  "scripts": {
    "dev:server": "npm run dev --prefix server",
    "dev:client": "npm run dev --prefix client",
    "build:client": "npm run build --prefix client",
    "db:setup": "npm run db:setup --prefix server",
    "install:all": "npm install --prefix server && npm install --prefix client",
    "test:e2e": "npm test --prefix qa/automation",
    "test:e2e:headed": "npm run test:headed --prefix qa/automation",
    "test:e2e:debug": "npm run test:debug --prefix qa/automation",
    "test:e2e:ui": "npm run test:ui --prefix qa/automation"
  }
}
