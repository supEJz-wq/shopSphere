# Server
PORT=5000

# PostgreSQL connection string (Supabase, Neon, RDS, local, ...)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"

# JWT
JWT_SECRET="super-secret-change-me"
JWT_EXPIRES_IN="7d"

# Frontend origin(s) for CORS (comma-separated if multiple)
# Include your deployed Vercel frontend URL in production.
CLIENT_URL="http://localhost:5173,https://your-frontend.vercel.app"
